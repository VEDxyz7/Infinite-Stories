            "title": "Mode",
            "default": "authored"
          },
          "location_id": {
            "type": "string",
            "title": "Location Id",
            "default": "quay"
          },
          "x": {
            "type": "number",
            "title": "X",
            "default": 4
          },
          "y": {
            "type": "number",
            "title": "Y",
            "default": 5
          },
          "visits": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Visits",
            "default": 1
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          },
          "choices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Choices"
          },
          "interests": {
            "items": {
              "$ref": "#/components/schemas/SavedInterest"
            },
            "type": "array",
            "title": "Interests"
          },
          "ending": {
            "type": "string",
            "title": "Ending",
            "default": ""
          },
          "history": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "History"
          },
          "cultural_source": {
            "type": "string",
            "enum": [
              "none",
              "qloo"
            ],
            "title": "Cultural Source",
            "default": "none"
          },
          "cultural_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CulturalContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GameState"
      },
      "GameView": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "session_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Session Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "state": {
            "$ref": "#/components/schemas/GameState"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "nearby": {
            "items": {
              "$ref": "#/components/schemas/WorldObject"
            },
            "type": "array",
            "title": "Nearby"
          },
          "objectives": {
            "items": {
              "$ref": "#/components/schemas/Objective"
            },
            "type": "array",
            "title": "Objectives"
          },
          "narrative": {
            "type": "string",
            "maxLength": 2000,
            "title": "Narrative",
            "default": ""
          },
          "narrative_source": {
            "type": "string",
            "enum": [
              "authored",
              "game_master_validated",
              "game_master_no_state_change",
              "cultural_evidence_tool"
            ],
            "title": "Narrative Source",
            "default": "authored"
          },
          "idempotent_replay": {
            "type": "boolean",
            "title": "Idempotent Replay",
            "default": false
          },
          "notices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "revision",
          "state",
          "location",
          "nearby",
          "objectives",
          "notices"
        ],
        "title": "GameView"
      },
      "GenerationRecovery": {
        "properties": {
