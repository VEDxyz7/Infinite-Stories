        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "text"
        ],
        "title": "Choice"
      },
      "Command": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "position",
              "interact",
              "choose",
              "travel",
              "inspect"
            ],
            "title": "Kind"
          },
          "target": {
            "type": "string",
            "maxLength": 80,
            "title": "Target",
            "default": ""
          },
          "choice": {
            "type": "string",
            "maxLength": 80,
            "title": "Choice",
            "default": ""
          },
          "x": {
            "type": "number",
            "maximum": 64.0,
            "minimum": 0.0,
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "number",
            "maximum": 64.0,
            "minimum": 0.0,
            "title": "Y",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Command"
      },
      "CulturalContext": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "source": {
            "type": "string",
            "const": "qloo",
            "title": "Source",
            "default": "qloo"
          },
          "rule_version": {
            "type": "string",
            "enum": [
              "cultural-cards-v1",
              "cultural-investigation-v2"
            ],
            "title": "Rule Version",
            "default": "cultural-cards-v1"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/CulturalLink"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Links"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "links"
        ],
        "title": "CulturalContext"
      },
      "CulturalEntity": {
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entity Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "artist",
              "movie",
              "brand",
              "videogame"
            ],
            "title": "Category"
          },
          "description": {
            "type": "string",
            "maxLength": 1200,
            "title": "Description",
            "default": ""
          },
          "disambiguation": {
            "type": "string",
            "maxLength": 200,
            "title": "Disambiguation",
            "default": ""
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "content_rating": {
            "type": "string",
            "maxLength": 40,
            "title": "Content Rating",
            "default": ""
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/CulturalTag"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entity_id",
          "name",
          "category"
        ],
        "title": "CulturalEntity"
      },
      "CulturalLink": {
        "properties": {
          "seed": {
            "$ref": "#/components/schemas/CulturalEntity"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/CulturalEntity"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Recommendations"
          },
          "selected_id": {
            "type": "string",
            "format": "uuid",
            "title": "Selected Id"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/CulturalRequest"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Evidence"
          },
          "setting": {
            "type": "string",
            "maxLength": 80,
            "title": "Setting"
          },
          "supporting_tag_id": {
            "type": "string",
            "maxLength": 200,
            "title": "Supporting Tag Id",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seed",
          "recommendations",
          "selected_id",
          "evidence",
          "setting"
        ],
        "title": "CulturalLink"
      },
      "CulturalRequest": {
        "properties": {
          "origin": {
            "type": "string",
            "const": "https://hackathon.api.qloo.com",
            "title": "Origin",
            "default": "https://hackathon.api.qloo.com"
          },
          "path": {
            "type": "string",
            "enum": [
              "/search",
              "/v2/insights"
            ],
            "title": "Path"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Params"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Body Sha256"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "params",
          "retrieved_at",
          "body_sha256",
          "elapsed_ms"
        ],
        "title": "CulturalRequest"
      },
      "CulturalTag": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "maxLength": 200,
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "title": "CulturalTag"
      },
      "GameState": {
        "properties": {
          "schema_version": {
            "type": "integer",
