  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "command"
        ],
        "title": "ActionRequest"
      },
      "Choice": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requires"
          },
          "grants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Grants"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "ending": {
            "type": "string",
            "title": "Ending",
            "default": ""
          }
