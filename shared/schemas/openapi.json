            "title": "Schema Version",
            "default": 1
          },
          "chapter_id": {
            "type": "string",
            "const": "last_light",
            "title": "Chapter Id",
            "default": "last_light"
          },
          "chapter_version": {
            "type": "integer",
            "const": 1,
            "title": "Chapter Version",
            "default": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "authored",
              "cultural"
