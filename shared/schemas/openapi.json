  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "command"
        ],
        "title": "ActionRequest"
      },
      "ActivationValidation": {
        "properties": {
          "version": {
            "type": "string",
            "const": "engine-witness-v1",
            "title": "Version"
          },
          "candidate": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Candidate"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Evidence Sha256"
          },
          "chapter_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Chapter Sha256"
          },
          "generation_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Sha256"
          },
          "generated_chapter_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated Chapter Sha256"
          },
          "commands_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Commands Sha256"
          },
          "steps": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Steps"
          },
          "visits": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Visits"
          },
          "ending": {
            "type": "string",
            "enum": [
              "together",
              "keeper"
            ],
            "title": "Ending"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "candidate",
          "evidence_sha256",
          "chapter_sha256",
          "commands_sha256",
          "steps",
          "visits",
          "ending"
        ],
        "title": "ActivationValidation"
      },
      "Choice": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requires"
          },
          "grants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Grants"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "ending": {
            "type": "string",
            "title": "Ending",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "text"
        ],
        "title": "Choice"
      },
      "CityGeneration": {
        "properties": {
          "version": {
            "type": "string",
            "const": "saved-cultural-city-v1",
            "title": "Version",
            "default": "saved-cultural-city-v1"
          },
          "seed": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Seed"
          },
          "candidate": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Candidate"
          },
          "template": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Template"
          },
          "proof_order": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Proof Order"
          },
          "trace_locations": {
            "items": {
              "type": "string",
              "enum": [
                "quay",
                "market",
                "archive"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Trace Locations"
          },
          "card_locations": {
            "items": {
              "type": "string",
              "enum": [
                "quay",
                "market",
                "archive"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Card Locations"
          },
          "resident_links": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Resident Links"
          },
          "distances": {
            "items": {
              "$ref": "#/components/schemas/CulturalDistance"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Distances"
          },
          "shortcut": {
            "items": {
              "type": "string",
              "enum": [
                "quay",
                "market",
                "archive",
                "station"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "title": "Shortcut"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seed",
          "candidate",
          "template",
          "proof_order",
          "trace_locations",
          "card_locations",
          "resident_links",
          "distances"
        ],
        "title": "CityGeneration"
      },
      "Command": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "position",
              "interact",
              "choose",
              "travel",
              "inspect"
            ],
            "title": "Kind"
          },
          "target": {
            "type": "string",
            "maxLength": 80,
            "title": "Target",
            "default": ""
          },
          "choice": {
            "type": "string",
            "maxLength": 80,
            "title": "Choice",
            "default": ""
          },
          "x": {
            "type": "number",
            "maximum": 64.0,
            "minimum": 0.0,
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "number",
            "maximum": 64.0,
            "minimum": 0.0,
            "title": "Y",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Command"
      },
      "CulturalContext": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "source": {
            "type": "string",
            "const": "qloo",
            "title": "Source",
            "default": "qloo"
          },
          "rule_version": {
            "type": "string",
            "enum": [
              "cultural-cards-v1",
              "cultural-investigation-v2",
              "cultural-understanding-v3"
            ],
            "title": "Rule Version",
            "default": "cultural-cards-v1"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/CulturalLink"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Links"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "links"
        ],
        "title": "CulturalContext"
      },
      "CulturalDistance": {
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Id"
          },
          "target_id": {
            "type": "string",
            "format": "uuid",
            "title": "Target Id"
          },
          "contrast": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Contrast"
          },
          "metadata_status": {
            "type": "string",
            "enum": [
              "comparable",
              "unknown"
            ],
            "title": "Metadata Status"
          },
          "comparable_domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Comparable Domains"
          },
          "shared_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Shared Tags"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "direct_saved_recommendation",
              "not_evaluated"
            ],
            "title": "Relationship",
            "default": "not_evaluated"
          },
          "paths": {
            "items": {
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Paths"
          },
          "method": {
            "type": "string",
            "const": "application-tag-jaccard-v1",
            "title": "Method",
            "default": "application-tag-jaccard-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "target_id",
          "metadata_status"
        ],
        "title": "CulturalDistance"
      },
      "CulturalEntity": {
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entity Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "artist",
              "movie",
              "brand",
              "videogame"
            ],
            "title": "Category"
          },
          "description": {
            "type": "string",
            "maxLength": 1200,
            "title": "Description",
            "default": ""
          },
          "disambiguation": {
            "type": "string",
            "maxLength": 200,
            "title": "Disambiguation",
            "default": ""
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "content_rating": {
            "type": "string",
            "maxLength": 40,
            "title": "Content Rating",
            "default": ""
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/CulturalTag"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entity_id",
          "name",
          "category"
        ],
        "title": "CulturalEntity"
      },
      "CulturalLink": {
        "properties": {
          "seed": {
            "$ref": "#/components/schemas/CulturalEntity"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/CulturalEntity"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Recommendations"
          },
          "selected_id": {
            "type": "string",
            "format": "uuid",
            "title": "Selected Id"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/CulturalRequest"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Evidence"
          },
          "setting": {
            "type": "string",
            "maxLength": 80,
            "title": "Setting"
          },
          "supporting_tag_id": {
            "type": "string",
            "maxLength": 200,
            "title": "Supporting Tag Id",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seed",
          "recommendations",
          "selected_id",
          "evidence",
          "setting"
        ],
        "title": "CulturalLink"
      },
      "CulturalRequest": {
        "properties": {
          "origin": {
            "type": "string",
            "const": "https://hackathon.api.qloo.com",
            "title": "Origin",
            "default": "https://hackathon.api.qloo.com"
          },
          "path": {
            "type": "string",
            "enum": [
              "/search",
              "/v2/insights"
            ],
            "title": "Path"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Params"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Body Sha256"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "params",
          "retrieved_at",
          "body_sha256",
          "elapsed_ms"
        ],
        "title": "CulturalRequest"
      },
      "CulturalTag": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "maxLength": 200,
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "title": "CulturalTag"
      },
      "GameState": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "chapter_id": {
            "type": "string",
            "const": "last_light",
            "title": "Chapter Id",
            "default": "last_light"
          },
          "chapter_version": {
            "type": "integer",
            "const": 1,
            "title": "Chapter Version",
            "default": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "authored",
              "cultural"
