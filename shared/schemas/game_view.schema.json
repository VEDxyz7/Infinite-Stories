{
  "$defs": {
    "ActivationValidation": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "engine-witness-v1",
          "title": "Version",
          "type": "string"
        },
        "candidate": {
          "maximum": 2,
          "minimum": 0,
          "title": "Candidate",
          "type": "integer"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "chapter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chapter Sha256",
          "type": "string"
        },
        "generation_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Sha256"
        },
        "generated_chapter_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated Chapter Sha256"
        },
        "commands_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Commands Sha256",
          "type": "string"
        },
        "steps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "visits": {
          "maximum": 12,
          "minimum": 1,
          "title": "Visits",
          "type": "integer"
        },
        "ending": {
          "enum": [
            "together",
            "keeper"
          ],
          "title": "Ending",
          "type": "string"
        }
      },
      "required": [
        "version",
        "candidate",
        "evidence_sha256",
        "chapter_sha256",
        "commands_sha256",
        "steps",
        "visits",
        "ending"
      ],
      "title": "ActivationValidation",
      "type": "object"
    },
