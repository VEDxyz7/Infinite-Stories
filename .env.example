# Placeholders only. Prefer process environment or a private file outside this folder.
QLOO_API_KEY=REPLACE_WITH_EVENT_ISSUED_KEY
# Leave false until the account owner verifies these facts against event/account terms.
QLOO_NONBILLABLE_CONFIRMED=false
QLOO_DIRECT_REST_APPROVED=false
QLOO_LOCAL_RETENTION_CONFIRMED=false
# Historical Phase 0 names; the backend uses the IS_* settings below.
LLM_PROVIDER=REPLACE_WITH_PROVIDER_IF_SELECTED
LLM_MODEL=REPLACE_WITH_ACCOUNT_ACCESSIBLE_MODEL
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY_IF_SELECTED

# Current backend reads IS_* settings plus the explicit private key/base aliases.
# Phase 0 confirmation flags above are legacy tooling, not independent verification.
IS_ENVIRONMENT=development
IS_DATABASE_URL=sqlite:///data/infinite_stories.sqlite3
IS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
IS_SESSION_DAYS=30
IS_REQUESTS_PER_MINUTE=120
# Optional documented OpenAI adapter. No default model is selected. Calls stay disabled.
IS_LLM_PROVIDER=
IS_LLM_MODEL=
# Standard OpenAI key is supported; optional IS_LLM_API_KEY takes precedence.
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_PROVIDER_KEY
IS_LLM_API_KEY=
# Set 'none' for the proposed gpt-6-luna experiment, after model/budget approval.
IS_LLM_REASONING_EFFORT=
IS_LLM_CALLS_ALLOWED=false
IS_LLM_TURN_LIMIT=20
IS_LLM_DAILY_TURN_LIMIT=20
# Public origin only, used by the Unity Editor build entry point; never add secrets.
IS_PUBLIC_API_URL=REPLACE_WITH_APPROVED_HTTPS_BACKEND_ORIGIN
# Legacy live smoke probe now also requires an explicitly verified event origin.
# User-confirmed hackathon origin. Never fall back to the production origin.
QLOO_APPROVED_BASE_URL=https://hackathon.api.qloo.com
QLOO_ENDPOINT_CONFIRMED=true
# Official harness requires both the custom origin and explicit trust for it.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Real server Qloo adapter. Keep disabled: no further live calls are authorized.
IS_QLOO_CALLS_ALLOWED=false
# Application safety cap, not the organizer's quota.
IS_QLOO_DAILY_REQUESTS=100
IS_QLOO_CACHE_SECONDS=3600
IS_QLOO_MIN_INTERVAL=1

# Free LOCAL inference option (explicit opt-in; no hosted fallback).
# IS_LLM_PROVIDER=ollama
# IS_LLM_MODEL=qwen3.5:4b
IS_LLM_BASE_URL=http://127.0.0.1:11434
# Run the local runtime with OLLAMA_NO_CLOUD=1; no API key is required.
# Keep IS_LLM_CALLS_ALLOWED=false until you intend to use the local runtime.
